{
  "name": "lumierelabs-daraja-monorepo",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docs:dev": "pnpm --filter @lumierelabs/daraja-docs dev",
    "docs:build": "pnpm --filter @lumierelabs/daraja-docs build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "coverage": "turbo run coverage --filter=@lumierelabs/daraja",
    "typecheck": "turbo run typecheck",
    "types:check": "turbo run types:check",
    "package:check": "turbo run package:check",
    "ci:local": "pnpm install --frozen-lockfile && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node -e \"if (!require('node:fs').existsSync('packages/sdk/dist')) process.exitCode = 1\" && pnpm --filter @lumierelabs/daraja package:check && pnpm audit --prod --audit-level moderate"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
