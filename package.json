{
  "name": "lumierelabs-daraja-monorepo",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "coverage": "turbo run coverage --filter=@lumierelabs/daraja",
    "typecheck": "turbo run typecheck",
    "types:check": "turbo run types:check",
    "package:check": "turbo run package:check",
    "ci:local": "pnpm install --frozen-lockfile && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && test -d packages/sdk/dist && pnpm --filter @lumierelabs/daraja package:check && pnpm audit --prod --audit-level moderate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.10.12"
  }
}
